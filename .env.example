# Public origin of this app, no trailing slash. Local dev: your tunnel URL.
PUBLIC_BASE_URL=https://vlku-line.fly.dev

OPENAI_API_KEY=sk-...

# Dashboard login
DASHBOARD_PASSWORD=change-me
# openssl rand -hex 32
SESSION_SECRET=
